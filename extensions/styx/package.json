{
  "name": "@styx/openclaw-plugin",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Styx self-hosted memory/context integration for OpenClaw.",
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.8.2",
      "minGatewayVersion": "2026.8.2"
    },
    "build": {
      "openclawVersion": "2026.8.2",
      "pluginSdkVersion": "2026.8.2"
    }
  },
  "scripts": {
    "build": "npm run check:version && tsc",
    "check:version": "node scripts/check-version.mjs",
    "test": "npm run build && node scripts/test-agent-end.mjs",
    "build:watch": "tsc --watch"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5"
  }
}
